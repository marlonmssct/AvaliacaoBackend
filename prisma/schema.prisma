generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum BatchStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum PurchaseStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  PIX
  BOLETO
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(CUSTOMER)
  phone        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  events             Event[]    @relation("OrganizerEvents")
  purchases          Purchase[]
  tickets            Ticket[]
  checkInsConducted  CheckIn[]  @relation("OperatorCheckIns")

  @@map("users")
}

model Event {
  id              String      @id @default(uuid())
  title           String
  description     String
  bannerUrl       String?     @map("banner_url")
  locationCep     String      @map("location_cep")
  locationAddress String      @map("location_address")
  locationCity    String      @map("location_city")
  locationState   String      @map("location_state")
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime    @map("ends_at")
  status          EventStatus @default(DRAFT)
  organizerId     String      @map("organizer_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  organizer User     @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  sectors   Sector[]

  @@map("events")
}

model Sector {
  id        String   @id @default(uuid())
  name      String
  capacity  Int
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  batches TicketBatch[]

  @@map("sectors")
}

model TicketBatch {
  id                String      @id @default(uuid())
  name              String
  price             Decimal     @db.Decimal(10, 2)
  totalQuantity     Int         @map("total_quantity")
  availableQuantity Int         @map("available_quantity")
  startSaleDate     DateTime    @map("start_sale_date")
  endSaleDate       DateTime    @map("end_sale_date")
  sectorId          String      @map("sector_id")
  status            BatchStatus @default(ACTIVE)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  sector  Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@map("ticket_batches")
}

model Purchase {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  totalAmount   Decimal        @map("total_amount") @db.Decimal(10, 2)
  status        PurchaseStatus @default(PAID)
  paymentMethod PaymentMethod  @default(CREDIT_CARD) @map("payment_method")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@map("purchases")
}

model Ticket {
  id            String       @id @default(uuid())
  code          String       @unique
  ticketBatchId String       @map("ticket_batch_id")
  purchaseId    String       @map("purchase_id")
  userId        String       @map("user_id")
  status        TicketStatus @default(VALID)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  batch    TicketBatch @relation(fields: [ticketBatchId], references: [id], onDelete: Cascade)
  purchase Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn  CheckIn?

  @@map("tickets")
}

model CheckIn {
  id                 String   @id @default(uuid())
  ticketId           String   @unique @map("ticket_id")
  checkedInByUserId  String   @map("checked_in_by_user_id")
  checkedInAt        DateTime @default(now()) @map("checked_in_at")
  notes              String?

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  checkedInBy User   @relation("OperatorCheckIns", fields: [checkedInByUserId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}
